<mxfile host="app.diagrams.net" modified="2026-08-01T00:00:00.000Z" agent="Codex" version="26.0.14" type="device">
  <diagram id="stage1-overview" name="阶段一总览">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DataHub Document Enrichment — 阶段一（Jaffle Shop 元数据与评估夹具）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1040" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="蓝色实线：已实现的数据流　·　紫色：只在本地的评估夹具　·　灰色虚线：后续阶段，当前未实现" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="42" y="66" width="1100" height="24" as="geometry"/></mxCell>

        <mxCell id="localGroup" value="项目本地：阶段一已实现" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#F7F9FC;swimlaneFillColor=#E9F2FF;strokeColor=#7AA7E8;fontStyle=1;fontSize=16;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="700" height="600" as="geometry"/></mxCell>
        <mxCell id="metadata" value="&lt;b&gt;demo/metadata/jaffle_shop.json&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;固定 Jaffle Shop 元数据&lt;/font&gt;&lt;br&gt;&lt;br&gt;• 3 Domains&lt;br&gt;• 7 Tags&lt;br&gt;• 3 Teams&lt;br&gt;• 11 Dataset 的名称、描述、字段、归属与标签&lt;br&gt;&lt;br&gt;&lt;i&gt;不含真实商家运营行数据&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F2FF;strokeColor=#4C8EDA;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="70" y="175" width="285" height="245" as="geometry"/></mxCell>
        <mxCell id="seed" value="&lt;b&gt;scripts/seed_demo.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;make seed-demo&lt;/font&gt;&lt;br&gt;&lt;br&gt;• 校验本地 fixture&lt;br&gt;• 构造固定 URN&lt;br&gt;• 为每个实体发出 Metadata Change Proposal&lt;br&gt;• 可重复运行（幂等）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4FF;strokeColor=#2F80ED;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="425" y="185" width="275" height="200" as="geometry"/></mxCell>
        <mxCell id="docs" value="&lt;b&gt;demo/documents/&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;8 篇 Markdown demo 文档&lt;/font&gt;&lt;br&gt;&lt;br&gt;业务文档样本&lt;br&gt;&lt;i&gt;当前只保存在项目本地&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EAFE;strokeColor=#9B51E0;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontColor=#3F2355;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="285" height="150" as="geometry"/></mxCell>
        <mxCell id="gold" value="&lt;b&gt;demo/gold/&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;8 份 gold YAML&lt;/font&gt;&lt;br&gt;&lt;br&gt;人工定义的预期 Domain / Tag / Owner / Dataset 关系&lt;br&gt;&lt;i&gt;当前只保存在项目本地&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EAFE;strokeColor=#9B51E0;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontColor=#3F2355;" vertex="1" parent="1"><mxGeometry x="425" y="500" width="275" height="150" as="geometry"/></mxCell>
        <mxCell id="fixtureCheck" value="&lt;b&gt;本地夹具完整性校验&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;verify_demo_data.py --offline&lt;/font&gt;&lt;br&gt;&lt;br&gt;确认 Markdown 存在；gold YAML 中引用的实体名称属于固定 fixture。&lt;br&gt;&lt;br&gt;&lt;b&gt;不读取文档语义，不做推荐结果比对。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D9;strokeColor=#E5A000;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontColor=#5C4400;" vertex="1" parent="1"><mxGeometry x="245" y="675" width="340" height="155" as="geometry"/></mxCell>

        <mxCell id="datahubGroup" value="本地 DataHub：阶段一写入目标" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#F7FBF8;swimlaneFillColor=#E5F5EA;strokeColor=#65A97A;fontStyle=1;fontSize=16;fontColor=#173D28;" vertex="1" parent="1"><mxGeometry x="800" y="115" width="500" height="600" as="geometry"/></mxCell>
        <mxCell id="proposal" value="&lt;b&gt;REST + MCP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;DatahubRestEmitter&lt;/font&gt;&lt;br&gt;&lt;br&gt;每个 entity + aspect&lt;br&gt;构成一条 Metadata Change Proposal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4FF;strokeColor=#2F80ED;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="835" y="190" width="190" height="160" as="geometry"/></mxCell>
        <mxCell id="gms" value="&lt;b&gt;DataHub GMS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;http://localhost:8080&lt;/font&gt;&lt;br&gt;&lt;br&gt;接收并持久化 metadata aspects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F5EA;strokeColor=#42A567;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontColor=#173D28;" vertex="1" parent="1"><mxGeometry x="1070" y="190" width="190" height="160" as="geometry"/></mxCell>
        <mxCell id="catalog" value="&lt;b&gt;已写入的模拟元数据&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 11 Dataset&lt;br&gt;　properties / schema / owner / domain / tags&lt;br&gt;• 3 Domain&lt;br&gt;• 7 Tag&lt;br&gt;• 3 Team&lt;br&gt;&lt;br&gt;&lt;i&gt;不包含 8 篇 Markdown 或 gold YAML&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F5EA;strokeColor=#42A567;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontColor=#173D28;" vertex="1" parent="1"><mxGeometry x="900" y="440" width="300" height="215" as="geometry"/></mxCell>
        <mxCell id="liveCheck" value="&lt;b&gt;DataHub 完整性回读&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;make verify-demo-data&lt;/font&gt;&lt;br&gt;&lt;br&gt;通过 GraphQL 只读确认实体存在，且 Dataset 具备 description、schema、owner。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D9;strokeColor=#E5A000;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontColor=#5C4400;" vertex="1" parent="1"><mxGeometry x="850" y="675" width="400" height="125" as="geometry"/></mxCell>

        <mxCell id="future" value="后续阶段：当前未实现" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#FAFAFA;swimlaneFillColor=#F0F2F5;strokeColor=#A5ADBA;fontStyle=1;fontSize=16;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1260" height="95" as="geometry"/></mxCell>
        <mxCell id="futureFlow" value="读取 Markdown 内容　→　提取 / 推荐 Domain、Tag、Owner、Dataset 关系　→　与 gold YAML 的 expected 对照　→　输出评估指标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5ADBA;dashed=1;dashPattern=8 8;fontSize=15;align=center;verticalAlign=middle;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="105" y="910" width="1130" height="36" as="geometry"/></mxCell>

        <mxCell id="e1" value="读取 fixture" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2F80ED;fontSize=12;fontColor=#2F80ED;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="metadata" target="seed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="emit MCP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2F80ED;fontSize=12;fontColor=#2F80ED;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="seed" target="proposal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="REST 写入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2F80ED;fontSize=12;fontColor=#2F80ED;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proposal" target="gms"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="持久化 aspects" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#42A567;fontSize=12;fontColor=#2E7D46;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gms" target="catalog"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="引用存在性" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9B51E0;fontSize=12;fontColor=#7D35B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="docs" target="fixtureCheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="引用有效性" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9B51E0;fontSize=12;fontColor=#7D35B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gold" target="fixtureCheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="GraphQL 只读回查" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#2F80ED;fontSize=12;fontColor=#2F80ED;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="catalog" target="liveCheck"><mxGeometry relative="1" as="geometry"/></mxCell>
