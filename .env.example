DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GRAPHQL_URL=http://localhost:8080/api/graphql
DATAHUB_TOKEN=
DATABASE_PATH=./data/document_enrichment.db
# dbmate uses this independently of FastAPI; `make migrate` loads this file. Relative to backend/.
DBMATE_DATABASE_URL=sqlite:./data/document_enrichment.db
CATALOG_CACHE_TTL_SECONDS=300
CORS_ORIGINS=http://localhost:5173
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=8000
# For DeepSeek Responses API, none disables thinking; use low/high/max only after an evaluation proves the need.
LLM_REASONING_EFFORT=none
